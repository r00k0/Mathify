{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mathify",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-01",
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": ["/api/*", "/k/*"] },
  "d1_databases": [
    { "binding": "DB", "database_name": "mathify-db", "database_id": "55bddaf1-7a65-4db6-9986-e53c0068b248", "migrations_dir": "migrations" }
  ],
  "workers_dev": true,
  "observability": { "enabled": true },
  "build": { "command": "node scripts/build.mjs" }
}
